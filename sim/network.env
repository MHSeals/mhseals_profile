# The sim's network: this machine only. Loopback is never a boat LAN, so no machine attaches to sim by address.
LAN_SUBNET=127.0.0.0/8
# A domain no vessel uses, so the sim never talks to a boat.
ROS_DOMAIN_ID=101
# No router, radios or lidar in the sim: the addresses the inherited lidar, radio and router kinds read are
# empty (set, so the profile loads; nothing to reach).
ROUTER_IP=
GATEWAY_IP=
NETMASK=
DNS_PRIMARY=
DNS_SECONDARY=
DHCP_START=
DHCP_COUNT=
STATIC_LEASES=
UBNT_ROCKET_IP=
UBNT_BULLET_IP=
LIDAR_IP=
