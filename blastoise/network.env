# Blastoise LAN addresses: the network env of this profile (its YAMLs and roboboat's read these as $KEY),
# also read through `hw.sh env` / ASTRO_NETWORK_ENV by astro_dock (setup, dev.bashrc), mhseals_nav and mhseals_testing.
# The router serves DHCP and Wi-Fi; the gateway device (any Linux host running the
# gateway stage) forwards the LAN's internet through its own routing, WARP included.
LAN_SUBNET=192.168.0.0/24
# mhseals_testing's name for LAN_SUBNET, until it reads LAN_SUBNET.
BOAT_SUBNET=192.168.0.0/24
# The vessel's ROS domain: astro_dock's prebuild sets the dev container's ROS_DOMAIN_ID from it.
ROS_DOMAIN_ID=42
NETMASK=255.255.255.0
ROUTER_IP=192.168.0.1
GATEWAY_IP=192.168.0.2
DHCP_START=100
DHCP_COUNT=50
# Reservations sit above the pool (.100-.149): MAC=hostname=address.
STATIC_LEASES="56:e2:03:5c:60:22=blastoise-odroid=192.168.0.152 3c:6d:66:bf:6b:e2=blastoise-jetson=192.168.0.153"
# The boat computer's DDS transport address (astro_dock's ros_net).
TRANSPORT_IP=192.168.0.152
# Boat computer serving time (chrony); `setup.linux.sh --components clock` uses it for ASTRO_NTP_SERVER=lan.
TIME_SERVER=192.168.0.152
# Operator laptops with internet time that the boat time server follows when the boat has no
# internet (they run `ASTRO_NTP_ALLOW=operator ./setup.linux.sh --components clock`).
OPERATOR_TIME_SERVERS="192.168.0.2"
DNS_PRIMARY=1.1.1.1
DNS_SECONDARY=8.8.8.8
# Ubiquiti airMAX radios, bridged onto this LAN (settings: roboboat/radio.yaml, blastoise/radio.yaml).
UBNT_ROCKET_IP=192.168.0.22
UBNT_BULLET_IP=192.168.0.21
# Velodyne VLP16 (settings: roboboat/lidar.yaml, blastoise/lidar.yaml; mhseals_nav reads LIDAR_IP).
# Static on the sensor (factory 192.168.1.201; netmask NETMASK, gateway ROUTER_IP); apply never moves this address.
LIDAR_IP=192.168.0.201
# Unicast UDP destination: the Orin runs the driver (~8 Mbit/s single return, ~16 dual).
LIDAR_DATA_HOST=192.168.0.153
